{% import 'frontend/components/icons.html.twig' as icons %}

<article aria-labelledby="game-{{ game.id }}" class="group flex min-w-0 flex-col overflow-hidden rounded-2xl border border-white/10 bg-surface-900/60 shadow-sm transition duration-200 hover:border-steam-400/35 hover:shadow-xl hover:shadow-black/20 focus-within:border-steam-400/35 motion-safe:hover:-translate-y-1 motion-reduce:transition-none">
    <div class="m-2.5 mb-0 overflow-hidden rounded-xl bg-surface-800">
        <img src="https://cdn.akamai.steamstatic.com/steam/apps/{{ game.id }}/header.jpg" alt="{{ game.name }}" width="460" height="215" class="aspect-video w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-105 motion-reduce:transition-none">
    </div>
    <div class="flex flex-1 flex-col px-5 pt-4 pb-5">
        <h3 id="game-{{ game.id }}" class="min-h-12 text-base leading-6 font-semibold tracking-tight text-white">{{ game.name }}</h3>
        <dl class="mt-4 space-y-2.5 text-xs">
            {% for label, value in {'Total playtime': game.total, 'Last 2 weeks': game.recent, 'Since last sync': game.sinceSync, 'Per day (sync)': game.perDay} %}
                <div class="flex items-baseline justify-between gap-3">
                    <dt class="text-surface-500">{{ label }}</dt>
                    <dd class="shrink-0 font-medium text-surface-200 tabular-nums">{{ value }}</dd>
                </div>
            {% endfor %}
        </dl>
        <div class="mt-5 flex items-center justify-between gap-3 border-t border-white/8 pt-4">
            {% if game.price %}
                <span class="inline-flex items-center rounded-lg bg-amber-400/10 px-3 py-2 text-xs font-semibold text-amber-200 ring-1 ring-amber-400/15 ring-inset tabular-nums">{{ game.price }}</span>
            {% endif %}
            <div class="ml-auto flex items-center gap-2">
                <a href="{{ path('frontend_game_details', {id: game.id}) }}" aria-label="Details for {{ game.name }}" title="Details" class="inline-flex size-11 items-center justify-center rounded-xl border border-steam-400/15 bg-steam-500/10 text-steam-200 transition-colors hover:border-steam-400/40 hover:bg-steam-500/20 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-steam-300">
                    {{ icons.icon('eye') }}
                </a>
                <a href="{{ path('frontend_game_delete', {id: game.id}) }}" aria-label="Deactivate {{ game.name }}" title="Deactivate" class="inline-flex size-11 items-center justify-center rounded-xl border border-transparent text-surface-500 transition-colors hover:border-red-400/20 hover:bg-red-500/10 hover:text-red-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-300">
                    {{ icons.icon('trash') }}
                </a>
            </div>
        </div>
    </div>
</article>
