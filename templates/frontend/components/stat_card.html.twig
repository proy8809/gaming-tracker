{% import 'frontend/components/icons.html.twig' as icons %}

<div class="relative overflow-hidden rounded-2xl border border-white/10 bg-surface-900/60 bg-linear-to-br from-white/3 to-transparent p-5 shadow-sm sm:p-6">
    <span aria-hidden="true" class="absolute inset-y-6 left-0 w-0.5 rounded-r-full {{ stat.accent }}"></span>
    <div class="flex items-center justify-between gap-3">
        <h2 class="text-sm font-medium text-surface-400">{{ stat.label }}</h2>
        <span class="flex size-10 shrink-0 items-center justify-center rounded-xl ring-1 ring-inset {{ stat.tint }}">
            {{ icons.icon(stat.icon) }}
        </span>
    </div>
    <p class="mt-4 text-3xl font-semibold tracking-tight text-white tabular-nums">{{ stat.value }}</p>
    <p class="mt-1.5 text-xs text-surface-500">{{ stat.caption }}</p>
</div>
