{% extends 'base.html.twig' %}

{% block title %}The Witcher 3 - Gaming Tracker{% endblock %}

{% block body %}
<div class="mx-auto max-w-3xl space-y-6">
    {# Breadcrumb #}
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-surface-500">
        <a href="{{ path('frontend_dashboard_index') }}" class="rounded transition-colors hover:text-surface-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-steam-400">Dashboard</a>
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        <span class="text-surface-400">Game Details</span>
    </nav>

    {# Game Header #}
    <div class="flex flex-col items-start gap-5 sm:flex-row">
        <img src="https://cdn.akamai.steamstatic.com/steam/apps/292030/header.jpg" alt="The Witcher 3" class="aspect-video w-full shrink-0 rounded-xl object-cover sm:h-24 sm:w-44">
        <div class="min-w-0">
            <h1 class="text-xl font-semibold tracking-tight text-white">The Witcher 3: Wild Hunt</h1>
            <p class="mt-0.5 text-sm text-surface-500">Steam ID: 292030</p>
            <div class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
                <span class="text-surface-400">Last 2 weeks: <span class="text-surface-200">4h 12m</span></span>
            </div>
        </div>
    </div>

    {# All-time and sync stats. Values are presentation samples, like the rest of this page. #}
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg border border-steam-400/20 bg-steam-500/5 p-4">
            <p class="text-xs font-medium uppercase tracking-wider text-steam-200">Total Played</p>
            <p class="mt-1 text-lg font-semibold text-white tabular-nums">127h 43m</p>
            <p class="text-xs text-surface-500">all time</p>
        </div>
        <div class="rounded-lg border border-steam-400/20 bg-steam-500/5 p-4">
            <p class="text-xs font-medium uppercase tracking-wider text-steam-200">Avg. per Day</p>
            <p class="mt-1 text-lg font-semibold text-white tabular-nums">4h 15m</p>
            <p class="text-xs text-surface-500">all time</p>
        </div>
        <div class="rounded-lg border border-surface-800 bg-surface-900/60 p-4">
            <p class="text-xs font-medium uppercase tracking-wider text-surface-500">Since Last Sync</p>
            <p class="mt-1 text-lg font-semibold text-white">12h 15m</p>
            <p class="text-xs text-surface-500">played since Sep 9</p>
        </div>
        <div class="rounded-lg border border-surface-800 bg-surface-900/60 p-4">
            <p class="text-xs font-medium uppercase tracking-wider text-surface-500">Avg. per Day</p>
            <p class="mt-1 text-lg font-semibold text-white">2h 02m</p>
            <p class="text-xs text-surface-500">since last sync</p>
        </div>
    </div>

    {# Purchase Price #}
    <div class="rounded-lg border border-surface-800 bg-surface-900/60 p-5">
        <h2 class="text-sm font-medium text-surface-300 mb-3"><label for="purchase-price">Purchase Price</label></h2>
        <form method="post" class="flex items-end gap-3">
            <div class="flex-1 max-w-xs">
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-surface-500 text-sm">$</span>
                    <input id="purchase-price" type="number" name="purchase_price" step="0.01" min="0" value="49.99" class="min-h-11 w-full rounded-lg border border-surface-700 bg-surface-950/50 py-2 pr-3 pl-7 text-sm text-surface-100 transition-colors focus:border-steam-400 focus:outline-2 focus:outline-steam-400">
                </div>
            </div>
            <button type="submit" class="min-h-11 cursor-pointer rounded-lg bg-steam-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-steam-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-steam-300">Save</button>
        </form>
    </div>

    {# Notes #}
    <div class="rounded-lg border border-surface-800 bg-surface-900/60 p-5">
        <h2 class="text-sm font-medium text-surface-300 mb-4">Notes</h2>

        {# Add Note #}
        <form method="post" class="mb-5">
            <label for="note-content" class="sr-only">Add a note</label>
            <textarea id="note-content" name="note_content" rows="3" placeholder="Add a note..." class="mb-2 w-full resize-y rounded-lg border border-surface-700 bg-surface-950/50 px-4 py-2.5 text-sm text-surface-100 transition-colors placeholder:text-surface-500 focus:border-steam-400 focus:outline-2 focus:outline-steam-400"></textarea>
            <div class="flex justify-end">
                <button type="submit" class="min-h-11 cursor-pointer rounded-lg bg-surface-800 px-4 py-2 text-sm font-medium text-surface-200 transition-colors hover:bg-surface-700 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-steam-300">Add Note</button>
            </div>
        </form>

        {# Notes List #}
        <div class="space-y-3">
            <div class="rounded-md bg-surface-950/50 p-3 group">
                <p class="text-sm text-surface-300 leading-relaxed">Just finished the Bloody Baron quest line. One of the best written storylines I've ever experienced in a game. The moral ambiguity is incredible.</p>
                <div class="mt-2 flex items-center justify-between">
                    <p class="text-xs text-surface-500">Sep 8, 2026 at 14:32</p>
                    <button type="button" aria-label="Delete note from Sep 8, 2026" class="inline-flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-lg text-surface-500 transition-colors hover:bg-red-500/10 hover:text-red-300 focus-visible:outline-2 focus-visible:outline-red-300">
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>
            </div>

            <div class="rounded-md bg-surface-950/50 p-3 group">
                <p class="text-sm text-surface-300 leading-relaxed">Gwent is dangerously addictive. Spent 3 hours playing cards instead of progressing the main story. No regrets.</p>
                <div class="mt-2 flex items-center justify-between">
                    <p class="text-xs text-surface-500">Sep 5, 2026 at 21:15</p>
                    <button type="button" aria-label="Delete note from Sep 5, 2026" class="inline-flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-lg text-surface-500 transition-colors hover:bg-red-500/10 hover:text-red-300 focus-visible:outline-2 focus-visible:outline-red-300">
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>
            </div>

            <div class="rounded-md bg-surface-950/50 p-3 group">
                <p class="text-sm text-surface-300 leading-relaxed">Started a Death March playthrough. Punishing on the hardest difficulty but incredibly rewarding.</p>
                <div class="mt-2 flex items-center justify-between">
                    <p class="text-xs text-surface-500">Aug 28, 2026 at 10:47</p>
                    <button type="button" aria-label="Delete note from Aug 28, 2026" class="inline-flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-lg text-surface-500 transition-colors hover:bg-red-500/10 hover:text-red-300 focus-visible:outline-2 focus-visible:outline-red-300">
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>
            </div>
        </div>
    </div>

    {# Back Link #}
    <div class="pt-2">
        <a href="{{ path('frontend_dashboard_index') }}" class="inline-flex min-h-11 items-center gap-1.5 rounded text-sm text-surface-500 transition-colors hover:text-surface-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-steam-400">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
            Back to Dashboard
        </a>
    </div>
</div>
{% endblock %}
