{% extends 'base.html.twig' %}

{% block title %}Delete Game - Gaming Tracker{% endblock %}

{% block body %}
<div class="mx-auto max-w-lg space-y-8">
    {# Breadcrumb #}
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-surface-400">
        <a href="{{ path('frontend_dashboard_index') }}" class="rounded transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-steam-400">Dashboard</a>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-surface-300">Deactivate Game</span>
    </nav>

    {# Warning Card #}
    <div class="rounded-2xl border border-red-500/30 bg-surface-900/60 p-6 text-center">
        <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-red-500/20">
            <svg class="h-8 w-8 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
            </svg>
        </div>
        <h1 class="text-2xl font-bold text-white">Deactivate Game</h1>
        <p class="mt-2 text-surface-400">Are you sure you want to deactivate this game?</p>
    </div>

    {# Game Preview #}
    <div class="rounded-2xl border border-white/10 bg-surface-900/60 p-6">
        <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center">
            <img src="https://cdn.akamai.steamstatic.com/steam/apps/292030/header.jpg" alt="The Witcher 3" class="aspect-video w-full rounded-xl object-cover sm:h-20 sm:w-36">
            <div>
                <h2 class="font-semibold text-white text-lg">The Witcher 3: Wild Hunt</h2>
                <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-surface-400">
                    <span>127h 43m played</span>
                    <span class="text-surface-600">|</span>
                    <span>Steam ID: 292030</span>
                </div>
            </div>
        </div>
    </div>

    {# What happens #}
    <div class="rounded-2xl border border-white/10 bg-surface-900/50 p-6">
        <h3 class="font-medium text-surface-200 mb-3">What happens when you deactivate:</h3>
        <ul class="space-y-2 text-sm text-surface-400">
            <li class="flex items-start gap-2">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-surface-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
                Game will be hidden from your dashboard
            </li>
            <li class="flex items-start gap-2">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-surface-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
                Excluded from future synchronizations
            </li>
            <li class="flex items-start gap-2">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-surface-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
                Playtime statistics will no longer be tracked
            </li>
            <li class="flex items-start gap-2">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-surface-300">All notes will be preserved and can be restored if you reactivate</span>
            </li>
        </ul>
    </div>

    {# Actions #}
    <div class="flex flex-wrap items-center justify-between gap-3">
        <a href="{{ path('frontend_dashboard_index') }}" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-surface-800 px-4 py-2.5 text-sm font-medium text-surface-100 transition-colors hover:bg-surface-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-steam-300">
            <svg class="mr-2 inline h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Go Back
        </a>
        <form method="post" onsubmit="return confirm('Are you absolutely sure? This action cannot be undone.')">
            <button type="submit" class="inline-flex min-h-11 cursor-pointer items-center justify-center rounded-lg border border-red-500/30 bg-red-600/20 px-5 py-2.5 text-sm font-medium text-red-300 transition-colors hover:bg-red-600/30 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-300">
                <svg class="mr-2 inline h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                Yes, Deactivate Game
            </button>
        </form>
    </div>
</div>
{% endblock %}
